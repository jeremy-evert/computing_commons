\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{commons-week2-theme}[2026/08/23 Computing Commons Week 2 visual system]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning}
\definecolor{ccnavy}{HTML}{102A43}
\definecolor{ccink}{HTML}{172B4D}
\definecolor{ccblue}{HTML}{2F80ED}
\definecolor{ccgreen}{HTML}{16866A}
\definecolor{ccgold}{HTML}{D99A2B}
\definecolor{ccmist}{HTML}{F3F7FB}
\definecolor{cccream}{HTML}{FFF8E8}
\definecolor{ccrose}{HTML}{FFF2F0}
\setbeamercolor{normal text}{fg=ccink,bg=white}
\setbeamercolor{frametitle}{fg=white,bg=ccnavy}
\setbeamercolor{structure}{fg=ccblue}
\setbeamercolor{block title}{fg=white,bg=ccnavy}
\setbeamercolor{block body}{fg=ccink,bg=ccmist}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{frametitle}{\nointerlineskip\begin{beamercolorbox}[wd=\paperwidth,ht=1.05cm,dp=.25cm,leftskip=.55cm]{frametitle}\usebeamerfont{frametitle}\insertframetitle\end{beamercolorbox}}
\setbeamertemplate{footline}{\hfill\color{ccnavy!60}\scriptsize\insertframenumber\hspace{.5cm}\vspace{.2cm}}
\setbeamertemplate{itemize item}{\color{ccblue}\small$\blacktriangleright$}
\newcommand{\cccard}[4][ccmist]{\begin{beamercolorbox}[wd=\linewidth,sep=.55em]{block body}\colorbox{#1}{\parbox{.96\linewidth}{\textcolor{#2}{\textbf{#3}}\par\vspace{.12cm}\raggedright\small#4}}\end{beamercolorbox}}
\newcommand{\doit}[1]{\begin{beamercolorbox}[wd=\linewidth,sep=.65em]{block body}\textcolor{ccgreen}{\textbf{DO THIS}}\quad #1\end{beamercolorbox}}
\newcommand{\whatmeans}[1]{\begin{beamercolorbox}[wd=\linewidth,sep=.5em]{block body}\textcolor{ccblue}{\textbf{WHAT THIS MEANS}}\quad #1\end{beamercolorbox}}
\newcommand{\receipt}[1]{\begin{beamercolorbox}[wd=\linewidth,sep=.5em]{block body}\textcolor{ccgold!80!black}{\textbf{KEEP THE RECEIPT}}\quad #1\end{beamercolorbox}}
\newcommand{\findyourself}[1]{\begin{beamercolorbox}[wd=\linewidth,sep=.5em]{block body}\textcolor{ccblue}{\textbf{FIND THIS YOURSELF}}\quad #1\end{beamercolorbox}}
\newcommand{\verify}[1]{\begin{beamercolorbox}[wd=\linewidth,sep=.5em]{block body}\textcolor{ccgreen}{\textbf{VERIFY ON YOUR MACHINE}}\quad #1\end{beamercolorbox}}
\newcommand{\securityquestions}{\begin{beamercolorbox}[wd=.96\linewidth,sep=.6em]{block body}\centering\textcolor{ccgold!80!black}{\textbf{Is this safe?\quad Is this secure?}}\par\vspace{.1cm}\textbf{How do I know?\quad Where can I verify that?}\end{beamercolorbox}}
\newcommand{\ladder}{\begin{beamercolorbox}[wd=.95\linewidth,sep=.3em,center]{block body}\tiny DO THIS $\rightarrow$ WHAT THIS MEANS $\rightarrow$ FIND THIS YOURSELF $\rightarrow$ DEMAND DOCUMENTATION\par\tiny VERIFY ON YOUR MACHINE $\rightarrow$ KEEP THE RECEIPT\end{beamercolorbox}}
\newcommand{\source}[1]{\vfill\tiny\color{ccnavy!55}Primary source: #1}
