@@ -1 +1,11 @@
 """One-responsibility surface: intentionally no neighboring helpers."""
+
+def cents_to_label(cents):
+    if cents < 0:
+        raise ValueError("Negative cents are not allowed.")
+    
+    dollars = cents // 100
+    cents_remaining = cents % 100
+    
+    label = f"${dollars}.{cents_remaining:02d}"
+    return label
