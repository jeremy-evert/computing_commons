ASSISTANT path/to/sidecar/experiments/aider_classroom_bite_research_024/fixture/module.py
ASSISTANT ```
ASSISTANT """Freshman-readable budget module with several neighboring responsibilities."""
ASSISTANT 
ASSISTANT 
ASSISTANT def cents_to_label(cents):
ASSISTANT     if cents < 0:
ASSISTANT         raise ValueError("cents must be non-negative")
ASSISTANT     return f"${cents / 100:.2f}"
ASSISTANT 
ASSISTANT 
ASSISTANT def add_expense(total_cents, expense_cents):
ASSISTANT     if expense_cents < 0:
ASSISTANT         raise ValueError("expense must be non-negative")
ASSISTANT     return total_cents + expense_cents
ASSISTANT 
ASSISTANT 
ASSISTANT def subtract_expense(total_cents, expense_cents):
ASSISTANT     if expense_cents < 0:
ASSISTANT         raise ValueError("expense must be non-negative")
ASSISTANT     return total_cents - expense_cents
ASSISTANT 
ASSISTANT 
ASSISTANT def summarize(expenses):
ASSISTANT     values = list(expenses)
ASSISTANT     total = sum(values)
ASSISTANT     return {"count": len(values), "total_cents": total, "average_cents": total // len(values) if values else 0}
ASSISTANT 
ASSISTANT 
ASSISTANT def largest_expense(expenses):
ASSISTANT     values = list(expenses)
ASSISTANT     return max(values) if values else 0
ASSISTANT 
ASSISTANT 
ASSISTANT def category_totals(expenses_by_category):
ASSISTANT     return {name: sum(values) for name, values in expenses_by_category.items()}
ASSISTANT 
ASSISTANT 
ASSISTANT def within_limit(total_cents, limit_cents):
ASSISTANT     return total_cents <= limit_cents
ASSISTANT 
ASSISTANT 
ASSISTANT def remaining_budget(limit_cents, spent_cents):
ASSISTANT     return max(0, limit_cents - spent_cents)
ASSISTANT ```
