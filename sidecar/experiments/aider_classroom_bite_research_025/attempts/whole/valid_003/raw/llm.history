USER aider_surface_fixture/module.py
USER ```
USER """Freshman-readable budget module with several neighboring responsibilities."""
USER 
USER 
USER def add_expense(total_cents, expense_cents):
USER     if expense_cents < 0:
USER         raise ValueError("expense must be non-negative")
USER     return total_cents + expense_cents
USER 
USER 
USER def subtract_expense(total_cents, expense_cents):
USER     if expense_cents < 0:
USER         raise ValueError("expense must be non-negative")
USER     return total_cents - expense_cents
USER 
USER 
USER def summarize(expenses):
USER     values = list(expenses)
USER     total = sum(values)
USER     return {"count": len(values), "total_cents": total, "average_cents": total // len(values) if values else 0}
USER 
USER 
USER def largest_expense(expenses):
USER     values = list(expenses)
USER     return max(values) if values else 0
USER 
USER 
USER def category_totals(expenses_by_category):
USER     return {name: sum(values) for name, values in expenses_by_category.items()}
USER 
USER 
USER def within_limit(total_cents, limit_cents):
USER     return total_cents <= limit_cents
USER 
USER 
USER def remaining_budget(limit_cents, spent_cents):
USER     return max(0, limit_cents - spent_cents)
USER ```
