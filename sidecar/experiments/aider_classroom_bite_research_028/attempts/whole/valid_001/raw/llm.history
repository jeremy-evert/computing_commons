USER 
USER 
USER def first_word(text):
USER     words = text.split()
USER     return words[0] if words else ""
USER 
USER 
USER def last_word(text):
USER     words = text.split()
USER     return words[-1] if words else ""
USER 
USER 
USER def has_word(text, word):
USER     return word in text.split()
USER 
USER 
USER def uppercase_words(words):
USER     return [word.upper() for word in words]
